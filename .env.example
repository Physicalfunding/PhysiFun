# ===========================================
# フィジファン 環境変数設定
# ===========================================

# -------------------------------------------
# フェーズ管理
# -------------------------------------------
# 1 = Phase 1（オーナー募集のみ）
# 2 = Phase 2（オーナー機能）
# 3 = Phase 3（一般公開）
NEXT_PUBLIC_RELEASE_PHASE=1

# -------------------------------------------
# Database
# -------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/crowfun_experience"

# -------------------------------------------
# Authentication
# -------------------------------------------
NEXTAUTH_SECRET="your-random-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------
# Storage (Supabase)
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
# Storage bucket name (optional, defaults to "crowfun-images")
SUPABASE_STORAGE_BUCKET="crowfun-images"

# -------------------------------------------
# 運営通知（Phase 1 で使用）
# -------------------------------------------
# カンマ区切りで複数のメールアドレスを指定
ADMIN_EMAIL_LIST="admin@example.com"
# メール送信（Resend）
RESEND_API_KEY="re_xxxx"
