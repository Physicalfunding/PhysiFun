{
  "name": "physifun",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "dev": "bun --filter @physifun/web dev",
    "dev:all": "bun --filter '@physifun/{web,admin}' dev",
    "build": "bun --filter @physifun/web build",
    "start": "bun --filter @physifun/web start",
    "lint": "bun --filter @physifun/web lint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter @physifun/web test",
    "test:watch": "bun --filter @physifun/web test:watch",
    "test:coverage": "bun --filter @physifun/web test:coverage",
    "test:infra": "bun --filter @physifun/infrastructure test",
    "db:generate": "bun --filter @physifun/infrastructure db:generate",
    "db:migrate": "bun --filter @physifun/infrastructure db:migrate",
    "db:migrate:deploy": "bun --filter @physifun/infrastructure db:migrate:deploy",
    "db:migrate:reset": "bun --filter @physifun/infrastructure db:migrate:reset",
    "db:push": "bun --filter @physifun/infrastructure db:push",
    "db:studio": "bun --filter @physifun/infrastructure db:studio",
    "dev:admin": "bun --filter @physifun/admin dev",
    "build:admin": "bun --filter @physifun/admin build",
    "test:e2e": "bun --filter @physifun/e2e test",
    "test:e2e:ui": "bun --filter @physifun/e2e test:ui",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
