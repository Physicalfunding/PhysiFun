# ===========================================
# 運営管理アプリ (apps/admin) 環境変数設定 (#147)
# ===========================================
#
# apps/admin は apps/web とは **別の Vercel プロジェクト** としてデプロイする想定。
# 本番では `admin.<本番ドメイン>` で公開し、Cookie は host-only (domain 未指定) で
# 親ドメインに漏れないよう apps/admin/src/lib/auth.ts で制御している。
#
# ⚠️ NEXTAUTH_SECRET は apps/web と **必ず別値** を設定すること。
#    同一値にすると両プロジェクトで署名付き Cookie が相互復号可能となり、
#    サブドメイン分離の意味が薄れる。

# -------------------------------------------
# Database
# -------------------------------------------
# apps/web と同じ Supabase PostgreSQL を参照する (AdminAccount / AdminSession は
# 同一 DB の別テーブル)。本番は Transaction Pooler URL を推奨。
DATABASE_URL="postgresql://user:password@localhost:5432/physifun"

# -------------------------------------------
# Authentication (NextAuth.js v4, Database strategy)
# -------------------------------------------
# apps/web と **別値** のランダム秘密鍵 (openssl rand -base64 32 等で生成)
NEXTAUTH_SECRET="admin-specific-random-secret-key-here"

# 本番では https のサブドメインを設定する。末尾スラッシュ禁止、パス不要。
#   本番例: https://admin.physifun.com
#   ローカル例: http://localhost:3001
# NextAuth は NEXTAUTH_URL が https:// で始まると自動的に secure Cookie +
# __Secure- / __Host- プレフィックスに切り替わる。
NEXTAUTH_URL="http://localhost:3001"

# -------------------------------------------
# Magic Link Mail (Resend)
# -------------------------------------------
# Resend API キー (apps/web と同じキーを流用してもよいが、使用量監視の観点では
# 別 API キーを推奨)
RESEND_API_KEY="re_xxxx"
# 差出人アドレス。Resend で verify 済みドメインのアドレスを指定する。
MAIL_FROM="noreply@physifun.com"

# -------------------------------------------
# Admin magic-link HMAC (#146 / PR #163)
# -------------------------------------------
# マジックリンクトークンの HMAC 署名鍵。NEXTAUTH_SECRET とは別管理する。
# 32 bytes 以上のランダム値を推奨 (openssl rand -base64 32)。
#
# ⚠️ 現時点 (PR #165 本体) では未参照のため空でも起動するが、#146 (PR #163) が
#    マージされると **必須** になる。推奨マージ順序は #163 → #165、
#    もしくは両 PR マージ後に Vercel 環境変数を一括設定すること。
#    詳細は apps/admin/README.md の該当セクションを参照。
ADMIN_MAGIC_LINK_HMAC_SECRET="admin-magic-link-hmac-secret-here"

# -------------------------------------------
# Vercel Cron (毎時 0 分に /api/cron/gc-admin-auth を実行)
# -------------------------------------------
# Vercel が Cron 実行時に Authorization ヘッダに Bearer で付与する secret。
# これを Route Handler 側で検証し、外部からの不正呼び出しを拒否する。
CRON_SECRET="admin-cron-secret-here"

# -------------------------------------------
# Storage (Supabase) - 審査画面のカバー画像表示用 (#120)
# -------------------------------------------
# apps/web と同じ値を設定する。admin 側は署名付き URL を生成する必要はないため
# SUPABASE_SERVICE_ROLE_KEY は任意。
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"
