# ===========================================
# フィジファン 環境変数設定
# ===========================================

# -------------------------------------------
# Database
# -------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/crowfun_experience"

# -------------------------------------------
# Authentication
# -------------------------------------------
NEXTAUTH_SECRET="your-random-secret-key-here"
# CSRF 検証で許可オリジンとして使用されるため、scheme + host (+ 必要ならポート) のみを設定してください。
# - 末尾スラッシュを入れない (NG: "https://app.physifun.com/"  OK: "https://app.physifun.com")
# - パス / クエリ / フラグメントは含めない
# - デフォルトポート (HTTPS の `:443`, HTTP の `:80`) は明示しない
#   (NG: "https://app.physifun.com:443"  OK: "https://app.physifun.com")
# - 本番では必ず HTTPS のドメインを設定する (例: https://app.physifun.com)
# - ローカル開発ではポート番号を含める (例: http://localhost:3000)
# 注意: 値が不正 (パースできない URL) の場合は開発 fallback に落ちず、すべての
# state-changing リクエストが 403 (origin_unresolved) で拒否される。
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------
# Storage (Supabase)
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
# Storage bucket name (optional, defaults to "project-images")
SUPABASE_STORAGE_BUCKET="project-images"

# -------------------------------------------
# 運営通知（Phase 1 で使用）
# -------------------------------------------
# カンマ区切りで複数のメールアドレスを指定
ADMIN_EMAIL_LIST="admin@example.com"
# メール送信（Resend）
RESEND_API_KEY="re_xxxx"
# アクティベーションメール本文に埋め込むベース URL (#187)
# 例: ローカル "http://localhost:3000" / リハーサル "https://physical-funding-staging.vercel.app"
# 末尾スラッシュは不要 (`${APP_URL}/activate?token=...` の形で結合される)
APP_URL="http://localhost:3000"

# Vercel Cron 用シークレット (Authorization: Bearer ${CRON_SECRET} の検証に使用)
CRON_SECRET="generate-via-openssl-rand-base64-32"
# 送信元アドレス。Resend で verify 済みのドメインを推奨。
# 未設定時は `outbox.ts` の getMailSender() が "noreply@physifun.com" にフォールバックする。
MAIL_FROM="noreply@physifun.com"
