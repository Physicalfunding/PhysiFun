// Phase 1 Prisma schema
// Issue #55 [SP1] 0-3 Prisma schema Phase 1 移行
//
// 参照:
//   - docs-repository/docs/202604_初回リリースに向けた計画/アカウント.md
//   - docs-repository/docs/202604_初回リリースに向けた計画/プロジェクト.md
//   - docs-repository/docs/202604_初回リリースに向けた計画/サポート募集.md
//   - docs-repository/docs/202604_初回リリースに向けた計画/Phase1_ドメイン移行マップ.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Account ====================
// アカウント (アカウント.md)
// 1 種類のアカウントエンティティ。ロールベースで権限を管理する。
model Account {
  id                 String        @id @default(uuid())
  email              String        @unique
  displayName        String // 表示名 (1〜50 文字、B-3 仮値)
  status             AccountStatus
  passwordHash       String? // ACTIVE 時は必須、PENDING_EMAIL_CONFIRMATION 時は null
  roles              Role[] // ["SUPPORTER"], ["SUPPORTER", "LEADER"] etc.
  activationToken    String?       @unique // アクティベーション用トークン (24h 有効)
  activationTokenExp DateTime? // activationToken の有効期限

  // プロフィール (任意、Phase 1 で追加)
  iconUrl  String?
  bio      String? @db.Text // 自己紹介 (〜500 文字、B-3 仮値)
  snsLinks Json? // { x, instagram, facebook, website }

  // 集計値 (Phase 1 では 0 固定、Phase 2 で加算)
  contributedHours Int @default(0) // 提供時間累計
  receivedHours    Int @default(0) // 参加時間累計

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  leaderApplications LeaderApplication[]
  projects           Project[]
  supportTickets     SupportTicket[]

  @@index([status])
  @@map("accounts")
}

enum AccountStatus {
  PENDING_EMAIL_CONFIRMATION
  ACTIVE
}

// SUPPORTER / LEADER の 2 値。運営権限は AdminAccount で分離管理するため ADMIN は含まない。
enum Role {
  SUPPORTER
  LEADER
}

// ==================== LeaderApplication ====================
// リーダー応募 (アカウント.md「LeaderApplication」)
// 1 Account につき PENDING は常に 1 件以下。Phase 1 ではアプリケーション層で担保し、
// 必要に応じて後続 PR で raw SQL の部分 unique index (WHERE status = 'PENDING') を追加する。
model LeaderApplication {
  id           String                  @id @default(uuid())
  accountId    String
  status       LeaderApplicationStatus
  reviewerNote String?                 @db.Text // 却下理由等、運営が付与
  reviewedBy   String? // 審査を行った AdminAccount.id。PENDING 時は null。

  // ProjectDraft 値オブジェクト (B-3 仮値の上限)
  projectTitle      String // 〜100
  projectSummary    String  @db.Text // 〜300
  projectStory      String  @db.Text // 〜5000 (Markdown)
  projectCategory   String // CATEGORY_MASTER 参照。enum にせず String で保持
  prefectureCode    String // "01"〜"47"
  municipality      String? // 任意、〜50
  plannedActivities String  @db.Text // 〜1000
  snsLinks          Json? // { x, instagram, facebook, website }

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  account  Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reviewer AdminAccount? @relation("AdminLeaderApplicationReview", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([status])
  @@index([submittedAt])
  @@index([reviewedBy])
  @@map("leader_applications")
}

enum LeaderApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==================== Project ====================
// プロジェクト (プロジェクト.md)
// Phase 1 では 3 値 PublishStatus + ProjectPhase の 2 軸で管理。
model Project {
  id             String  @id @default(uuid())
  ownerAccountId String
  slug           String? @unique // 公開時に発行

  // ヘッダー情報
  title          String // 〜100 (B-3 仮値)
  summary        String? @db.Text // 〜300 (B-3 仮値)。DRAFT 時は null 許容
  story          String? @db.Text // プロジェクト本文 Markdown (B-3 仮値)。DRAFT 時は null 許容
  leaderIntro    String? @db.Text // リーダー紹介 Markdown。DRAFT 時は null 許容
  coverImageUrl  String?
  category       String? // CATEGORY_MASTER の値 (string 保持)。DRAFT 時は null 許容
  prefectureCode String? // JIS X 0401 "01"〜"47"。DRAFT 時は null 許容
  municipality   String? // 任意
  snsLinks       Json? // { x, instagram, facebook, website }
  activityPlan   String? @db.Text // 活動計画 〜1000。任意

  // ステータス (2 軸)
  status PublishStatus @default(DRAFT)
  phase  ProjectPhase  @default(VISION)

  // 運営審査メタ (AdminAccount.id 参照)
  reviewedBy          String? // 直近の審査者 (APPROVED/REJECTED 時に記録)
  forcedUnpublishedBy String? // 強制非公開を実施した運営者

  // 公開タイムスタンプ
  publishRequestedAt DateTime?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  owner               Account                 @relation(fields: [ownerAccountId], references: [id], onDelete: Cascade)
  reviewer            AdminAccount?           @relation("AdminProjectReview", fields: [reviewedBy], references: [id], onDelete: Restrict)
  forcedUnpublisher   AdminAccount?           @relation("AdminProjectForceUnpublish", fields: [forcedUnpublishedBy], references: [id], onDelete: Restrict)
  reviewFeedbacks     ProjectReviewFeedback[]
  supportRecruitments SupportRecruitment[]

  @@index([ownerAccountId])
  @@index([status])
  @@index([category])
  @@index([prefectureCode])
  @@index([publishedAt])
  @@index([reviewedBy])
  @@index([forcedUnpublishedBy])
  @@map("projects")
}

enum PublishStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
}

enum ProjectPhase {
  VISION
  PLANNING
  PREPARATION
  EXECUTION
  COMPLETED
}

// ==================== ProjectReviewFeedback ====================
// プロジェクト公開審査の履歴 (プロジェクト.md「プロジェクト公開審査ワークフロー」)
model ProjectReviewFeedback {
  id         String       @id @default(uuid())
  projectId  String
  reviewerId String // AdminAccount.id
  action     ReviewAction
  note       String? // 差戻・強制非公開時は必須
  reviewedAt DateTime     @default(now())
  createdAt  DateTime     @default(now())

  // Relations
  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer AdminAccount @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([reviewerId])
  @@index([reviewedAt])
  @@map("project_review_feedbacks")
}

enum ReviewAction {
  APPROVED
  REJECTED
  FORCE_UNPUBLISHED
}

// ==================== SupportRecruitment ====================
// サポート募集 (サポート募集.md)
// Phase 1 はリーダー側の作成 UI まで実装、サポーター側の申請は Phase 2
model SupportRecruitment {
  id          String          @id @default(uuid())
  projectId   String
  type        RecruitmentType @default(ACTIVITY) // Phase 1 は ACTIVITY のみ
  title       String
  description String          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedules RecruitmentSchedule[]

  @@index([projectId])
  @@map("support_recruitments")
}

enum RecruitmentType {
  ACTIVITY
}

// ==================== RecruitmentSchedule ====================
// 募集スケジュール (1 日単位)
model RecruitmentSchedule {
  id                   String       @id @default(uuid())
  supportRecruitmentId String
  date                 DateTime     @db.Date // JST カレンダー日付。Prisma は UTC 深夜として返すため、日付比較は必ずアプリケーション層で JST として扱う
  startTime            String // "HH:MM" JST
  endTime              String // "HH:MM" JST
  capacityPerHour      Int
  approvalMode         ApprovalMode @default(AUTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  supportRecruitment SupportRecruitment @relation(fields: [supportRecruitmentId], references: [id], onDelete: Cascade)
  supportTickets     SupportTicket[]

  // 同一募集 x 同一日付の重複行を禁止 (1 日単位 = 1 スケジュール)
  @@unique([supportRecruitmentId, date])
  @@index([date])
  @@map("recruitment_schedules")
}

enum ApprovalMode {
  AUTO
  MANUAL
}

// ==================== SupportTicket ====================
// サポートチケット (1 申請 = 1 チケット)
model SupportTicket {
  id                    String              @id @default(uuid())
  recruitmentScheduleId String
  supporterAccountId    String
  duration              Int // 時間数 (1, 2, 4)
  slotStart             String // "HH:MM" JST
  companionCount        Int                 @default(0)
  status                SupportTicketStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  recruitmentSchedule RecruitmentSchedule @relation(fields: [recruitmentScheduleId], references: [id], onDelete: Cascade)
  // チケット履歴は監査観点で残すため、Account 削除時はブロックする (Restrict)
  supporter           Account             @relation(fields: [supporterAccountId], references: [id], onDelete: Restrict)

  @@index([recruitmentScheduleId])
  @@index([supporterAccountId])
  @@index([status])
  @@map("support_tickets")
}

enum SupportTicketStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ==================== LeaderApplicationOutboxMessage ====================
// リーダー応募ドメイン専用 Outbox (アカウント.md / プロジェクト.md「Outbox テーブル」)
model LeaderApplicationOutboxMessage {
  id             String    @id @default(uuid())
  type           String // LeaderApplicationOutboxType
  payload        Json
  createdAt      DateTime  @default(now())
  sentAt         DateTime? // 送信完了時刻 (null = 未送信)
  attempts       Int       @default(0)
  lastError      String?   @db.Text
  nextRetryAt    DateTime?
  deadLetteredAt DateTime? // dead-letter 化された時刻 (non-null = 再処理対象外)

  @@index([sentAt, deadLetteredAt, nextRetryAt])
  @@map("leader_application_outbox_messages")
}

// ==================== ProjectOutboxMessage ====================
// プロジェクトドメイン専用 Outbox
model ProjectOutboxMessage {
  id             String    @id @default(uuid())
  type           String // ProjectOutboxType
  payload        Json
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  attempts       Int       @default(0)
  lastError      String?   @db.Text
  nextRetryAt    DateTime?
  deadLetteredAt DateTime? // dead-letter 化された時刻 (non-null = 再処理対象外)

  @@index([sentAt, deadLetteredAt, nextRetryAt])
  @@map("project_outbox_messages")
}

// ==================== AdminAccount ====================
// 運営アカウント (Phase 2 準備 #140 / #144)
// apps/admin 用の認証基盤。apps/web の Account とは完全に分離する。
//
// ## 削除ポリシー
// AdminAccount は**物理削除しない**運用（監査証跡を永続保持するため）。
// 無効化は `status: DISABLED` で論理削除する (AdminAccount.disable())。
// これに伴い、FK は全て `onDelete: Restrict` にしている:
// - LeaderApplication.reviewedBy / Project.reviewedBy / forcedUnpublishedBy
//   → nullable だが、過去の審査履歴を辿れるよう SET NULL は採用しない
// - ProjectReviewFeedback.reviewerId → 非 null の監査レコードなので Restrict 一択
// - AdminAuditLog.adminAccountId → 監査証跡。Restrict
// - AdminSession.adminAccountId → 失効はアプリケーション層で行うため Cascade
model AdminAccount {
  id            String             @id @default(uuid())
  email         String             @unique
  passwordHash  String
  totpSecret    String? // 暗号化済み TOTP シークレット (暗号化は application 層)
  totpEnabled   Boolean            @default(false)
  recoveryCodes String[] // ハッシュ化済みリカバリコード (bcrypt 等)
  status        AdminAccountStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  sessions                   AdminSession[]
  auditLogs                  AdminAuditLog[]
  reviewedLeaderApplications LeaderApplication[]     @relation("AdminLeaderApplicationReview")
  reviewedProjects           Project[]               @relation("AdminProjectReview")
  forcedUnpublishedProjects  Project[]               @relation("AdminProjectForceUnpublish")
  projectReviewFeedbacks     ProjectReviewFeedback[]

  @@index([status])
  @@map("admin_accounts")
}

enum AdminAccountStatus {
  ACTIVE
  DISABLED
}

// ==================== AdminSession ====================
// 運営セッション (NextAuth Database 戦略、#140-2 で接続)
// DB レコード削除 = 強制 revoke。
model AdminSession {
  id             String   @id @default(uuid())
  sessionToken   String   @unique
  adminAccountId String
  expires        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  adminAccount AdminAccount    @relation(fields: [adminAccountId], references: [id], onDelete: Cascade)
  auditLogs    AdminAuditLog[]

  @@index([adminAccountId])
  @@index([expires])
  @@map("admin_sessions")
}

// ==================== AdminAuditLog ====================
// 運営操作の監査ログ (#140-6 で UI 接続)
// セッションが失効・削除された後も履歴を残すため adminSessionId は SetNull。
model AdminAuditLog {
  id             String   @id @default(uuid())
  adminAccountId String
  adminSessionId String?
  action         String // "leader_application.approve" / "project.force_unpublish" 等
  targetType     String // "LeaderApplication" / "Project" 等
  targetId       String? // 対象エンティティ ID (任意操作は null)
  metadata       Json? // アクション固有のペイロード
  createdAt      DateTime @default(now())

  adminAccount AdminAccount  @relation(fields: [adminAccountId], references: [id], onDelete: Restrict)
  adminSession AdminSession? @relation(fields: [adminSessionId], references: [id], onDelete: SetNull)

  @@index([adminAccountId])
  @@index([adminSessionId])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
