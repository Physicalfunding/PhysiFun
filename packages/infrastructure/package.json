{
  "name": "@physifun/infrastructure",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "bun run prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:kysely:codegen": "kysely-codegen --dialect postgres --out-file src/database/kysely/types.generated.ts",
    "db:atlas:diff": "atlas migrate diff --env local",
    "db:atlas:apply": "atlas migrate apply --env local",
    "db:atlas:status": "atlas migrate status --env local",
    "db:atlas:lint": "atlas migrate lint --env local --latest 1",
    "db:atlas:inspect": "atlas schema inspect --env local --url \"$DATABASE_URL\" --format '{{ sql . }}'"
  },
  "dependencies": {
    "@physifun/application": "workspace:*",
    "@physifun/domain": "workspace:*",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.3",
    "kysely": "^0.29.2",
    "next-auth": "^4.24.11",
    "pg": "^8.21.0",
    "resend": "^6.9.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.4.5",
    "kysely-codegen": "^0.20.0",
    "prisma": "^6.9.0",
    "testcontainers": "^11.14.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
