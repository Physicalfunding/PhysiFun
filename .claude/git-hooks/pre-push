#!/usr/bin/env bash
# git pre-push hook: クラウドセッションで、許可リスト外のファイルを含むコミットの push を止める
# 実際に push されるコミットだけを判定する（今いるブランチではなく、git が渡す ref を見る）。
# cloud-setup.sh がクラウドのときだけ core.hooksPath=.claude/git-hooks を設定する。ローカルでは何もしない。
# 参照: docs/guides/ai-harness.md 4 章・P1

[[ "${CLAUDE_CODE_REMOTE:-}" == "true" ]] || exit 0

ROOT=$(git rev-parse --show-toplevel) || exit 0
ALLOWLIST="${CLOUD_ALLOWLIST:-$ROOT/.claude/cloud-allowlist}"
# shellcheck source=../hooks/lib/allowlist.sh
source "$(dirname "$0")/../hooks/lib/allowlist.sh"

REMOTE="${1:-origin}"
ZERO=0000000000000000000000000000000000000000
FILES=""

# 新しいブランチは「リモートの main との共通の祖先」から判定する。ローカルの $REMOTE/main が古いと
# main で進んだ変更まで今回の push に数えてしまうため、判定の前に最新にする（失敗しても手元の ref で続ける）
git fetch -q "$REMOTE" "+refs/heads/main:refs/remotes/$REMOTE/main" 2>/dev/null || true

# stdin: <local ref> <local sha> <remote ref> <remote sha>
names() { git -c core.quotePath=false diff --name-only --no-renames "$1" "$2" | sort -u; }

while read -r _lref lsha _rref rsha; do
  [[ "$lsha" == "$ZERO" ]] && continue # ブランチの削除
  # main との共通の祖先からの差分 = このブランチ自身の変更（main をマージして取り込んだ変更は含まない）
  mb=$(git merge-base "$REMOTE/main" "$lsha" 2>/dev/null)
  if [[ "$rsha" != "$ZERO" ]] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    # 既存のリモートブランチ: 新しく送るコミットの変更のうち、このブランチ自身の変更だけを判定する
    if [[ -n "$mb" ]]; then
      FILES+=$(comm -12 <(names "$rsha" "$lsha") <(names "$mb" "$lsha"))$'\n'
    else
      FILES+=$(names "$rsha" "$lsha")$'\n'
    fi
  else
    [[ -n "$mb" ]] || {
      echo "$REMOTE/main との共通の祖先が分からないため push を止めました。git fetch $REMOTE main を実行してから再試行してください。" >&2
      exit 1
    }
    FILES+=$(names "$mb" "$lsha")$'\n'
  fi
done

BLOCKED=$(printf '%s' "$FILES" | sort -u | blocked_files)
[[ -z "$BLOCKED" ]] && exit 0

{
  echo "クラウドセッションでは次のファイルを含むコミットを push できません（docs/guides/ai-harness.md 4 章）:"
  sed 's/^/  /' <<<"$BLOCKED"
  echo "変更を取り消し、cloud-plan skill で計画書を docs-repository の plans/ に書いて PR にしてください。"
} >&2
exit 1
