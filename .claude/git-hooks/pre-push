#!/usr/bin/env bash
# git pre-push hook: クラウドセッションで、許可リスト外のファイルを含むコミットの push を止める
# 実際に push されるコミットだけを判定する（今いるブランチではなく、git が渡す ref を見る）。
# cloud-setup.sh がクラウドのときだけ core.hooksPath=.claude/git-hooks を設定する。ローカルでは何もしない。
# 参照: docs/guides/ai-harness.md 4 章・P1

[[ "${CLAUDE_CODE_REMOTE:-}" == "true" ]] || exit 0

ROOT=$(git rev-parse --show-toplevel) || exit 0
ALLOWLIST="${CLOUD_ALLOWLIST:-$ROOT/.claude/cloud-allowlist}"
# shellcheck source=../hooks/lib/allowlist.sh
source "$(dirname "$0")/../hooks/lib/allowlist.sh"

REMOTE="${1:-origin}"
ZERO=0000000000000000000000000000000000000000
FILES=""

# リモートのブランチにすでにあるコミットは数えない。ローカルの $REMOTE/* が古いと、リモートで進んだコミット
# まで今回の push に数えてしまうため、判定の前に最新にする（失敗しても手元の ref で続ける）
git fetch -q "$REMOTE" "+refs/heads/*:refs/remotes/$REMOTE/*" 2>/dev/null || true
HAS_REMOTE_BRANCHES=$(git for-each-ref --count=1 "refs/remotes/$REMOTE/")

# new_files <local sha> [<remote sha>] → 新しく送るコミット（どのリモートのブランチにも無いもの）が変えたファイル。
# main や親 Issue の開発ブランチから取り込んだコミットは、リモートにあるので数えない（#386）。
# マージのコミットは、どの親とも中身が違うファイルだけを出す（-c）。取り込んだ側の変更は数えず、
# 衝突を新しい中身で解決したものは数える
new_files() {
  local lsha="$1"
  shift
  git -c core.quotePath=false -c log.showRoot=true log --format= --name-only --no-renames -c \
    "$lsha" --not "$@" --remotes="$REMOTE"
}

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _lref lsha rref rsha; do
  [[ "$lsha" == "$ZERO" ]] && continue # ブランチの削除
  if [[ "$rsha" != "$ZERO" ]] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    if [[ "$rref" == refs/heads/main ]]; then
      # main への push: ほかのリモートのブランチから取り込んだ変更も、PR を通さずに main に入るので、差分をすべて数える
      FILES+=$(git -c core.quotePath=false diff --name-only --no-renames "$rsha" "$lsha")$'\n'
    else
      FILES+=$(new_files "$lsha" "$rsha")$'\n'
    fi
  else
    [[ -n "$HAS_REMOTE_BRANCHES" ]] || {
      echo "$REMOTE のブランチが分からないため push を止めました。git fetch $REMOTE を実行してから再試行してください。" >&2
      exit 1
    }
    FILES+=$(new_files "$lsha")$'\n'
  fi
done

BLOCKED=$(printf '%s' "$FILES" | sort -u | blocked_files)
[[ -z "$BLOCKED" ]] && exit 0

{
  echo "クラウドセッションでは次のファイルを含むコミットを push できません（docs/guides/ai-harness.md 4 章）:"
  sed 's/^/  /' <<<"$BLOCKED"
  echo "変更を取り消し、cloud-plan skill で計画書を docs-repository の plans/ に書いて PR にしてください。"
} >&2
exit 1
