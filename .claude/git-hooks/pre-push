#!/usr/bin/env bash
# git pre-push hook: クラウドセッションで、許可リスト外のファイルを含むコミットの push を止める
# 実際に push されるコミットだけを判定する（今いるブランチではなく、git が渡す ref を見る）。
# cloud-setup.sh がクラウドのときだけ core.hooksPath=.claude/git-hooks を設定する。ローカルでは何もしない。
# 参照: docs/guides/ai-harness.md 4 章・P1

[[ "${CLAUDE_CODE_REMOTE:-}" == "true" ]] || exit 0

ROOT=$(git rev-parse --show-toplevel) || exit 0
ALLOWLIST="${CLOUD_ALLOWLIST:-$ROOT/.claude/cloud-allowlist}"
# shellcheck source=../hooks/lib/allowlist.sh
source "$(dirname "$0")/../hooks/lib/allowlist.sh"

REMOTE="${1:-origin}"
ZERO=0000000000000000000000000000000000000000
FILES=""

# 判定の基準は「リモートのブランチとの共通の祖先」。ローカルの $REMOTE/* が古いと、リモートで進んだ変更
# まで今回の push に数えてしまうため、判定の前に最新にする（失敗しても手元の ref で続ける）
git fetch -q "$REMOTE" "+refs/heads/*:refs/remotes/$REMOTE/*" 2>/dev/null || true

# stdin: <local ref> <local sha> <remote ref> <remote sha>
names() { git -c core.quotePath=false diff --name-only --no-renames "$1" "$2" | sort -u; }

# base <local sha> <remote ref> → 判定の基準（共通の祖先）を出す。リモートのブランチ（push 先そのものは除く）
# のうち、push するコミットにあってそのブランチに無いコミットが一番少ないもの（= 切った元。main か親 Issue の
# 開発ブランチ。同数なら main）との共通の祖先にする。リモートのブランチの中身は、ガードを通ったものか
# ローカルで入れたものなので数えない（#386。開発ブランチに先に入った🔴の変更で止めないため）
base() {
  local ref n best="" min=""
  while read -r ref; do
    [[ "$ref" == "refs/remotes/$REMOTE/${2#refs/heads/}" ]] && continue
    n=$(git rev-list --count "$ref..$1" 2>/dev/null) || continue
    if [[ -z "$min" ]] || ((n < min)); then best=$ref min=$n; fi
  done < <(echo "refs/remotes/$REMOTE/main" && git for-each-ref --format='%(refname)' "refs/remotes/$REMOTE/")
  [[ -n "$best" ]] && git merge-base "$best" "$1" 2>/dev/null
}

while read -r _lref lsha rref rsha; do
  [[ "$lsha" == "$ZERO" ]] && continue # ブランチの削除
  # 基準からの差分 = このブランチ自身の変更（main や開発ブランチをマージして取り込んだ変更は含まない）
  mb=$(base "$lsha" "$rref")
  if [[ "$rsha" != "$ZERO" ]] && git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    # 既存のリモートブランチ: 新しく送るコミットの変更のうち、このブランチ自身の変更だけを判定する
    if [[ -n "$mb" ]]; then
      FILES+=$(comm -12 <(names "$rsha" "$lsha") <(names "$mb" "$lsha"))$'\n'
    else
      FILES+=$(names "$rsha" "$lsha")$'\n'
    fi
  else
    [[ -n "$mb" ]] || {
      echo "$REMOTE のブランチとの共通の祖先が分からないため push を止めました。git fetch $REMOTE を実行してから再試行してください。" >&2
      exit 1
    }
    FILES+=$(names "$mb" "$lsha")$'\n'
  fi
done

BLOCKED=$(printf '%s' "$FILES" | sort -u | blocked_files)
[[ -z "$BLOCKED" ]] && exit 0

{
  echo "クラウドセッションでは次のファイルを含むコミットを push できません（docs/guides/ai-harness.md 4 章）:"
  sed 's/^/  /' <<<"$BLOCKED"
  echo "変更を取り消し、cloud-plan skill で計画書を docs-repository の plans/ に書いて PR にしてください。"
} >&2
exit 1
