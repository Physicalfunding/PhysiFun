// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== User ====================
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  bio          String?
  avatarUrl    String?
  userType     UserType
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  projects         Project[]
  participations   Participation[]
  sentMessages     Message[]       @relation("sender")
  receivedMessages Message[]       @relation("receiver")

  @@index([email])
  @@map("users")
}

enum UserType {
  HOST
  GUEST
}

// ==================== Project ====================
model Project {
  id          String        @id @default(uuid())
  hostId      String
  title       String
  summary     String        @db.Text
  description String        @db.Text
  category    String
  location    String
  imageUrls   String[]
  status      ProjectStatus @default(DRAFT)
  slug        String?       @unique
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  // Relations
  host      User                 @relation(fields: [hostId], references: [id])
  returns   Return[]
  schedules ExperienceSchedule[]

  @@index([hostId])
  @@index([status])
  @@index([category])
  @@index([location])
  @@index([publishedAt])
  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

// ==================== Return ====================
model Return {
  id                    String    @id @default(uuid())
  projectId             String
  name                  String
  description           String    @db.Text
  estimatedDeliveryDate DateTime?
  quantityLimit         Int?
  order                 Int       @default(0)
  createdAt             DateTime  @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("returns")
}

// ==================== ExperienceSchedule ====================
model ExperienceSchedule {
  id            String   @id @default(uuid())
  projectId     String
  title         String
  description   String   @db.Text
  startDateTime DateTime
  duration      Int? // in minutes
  capacity      Int
  requirements  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participations Participation[]

  @@index([projectId])
  @@index([startDateTime])
  @@map("experience_schedules")
}

// ==================== Participation ====================
model Participation {
  id               String              @id @default(uuid())
  guestId          String
  scheduleId       String
  participantCount Int                 @default(1)
  status           ParticipationStatus @default(PENDING)
  appliedAt        DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  guest    User               @relation(fields: [guestId], references: [id])
  schedule ExperienceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([guestId, scheduleId])
  @@index([guestId])
  @@index([scheduleId])
  @@index([status])
  @@map("participations")
}

enum ParticipationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ==================== Message ====================
model Message {
  id              String    @id @default(uuid())
  senderId        String
  receiverId      String
  subject         String
  body            String    @db.Text
  isRead          Boolean   @default(false)
  parentMessageId String?
  createdAt       DateTime  @default(now())
  readAt          DateTime?

  // Relations
  sender        User      @relation("sender", fields: [senderId], references: [id])
  receiver      User      @relation("receiver", fields: [receiverId], references: [id])
  parentMessage Message?  @relation("replies", fields: [parentMessageId], references: [id])
  replies       Message[] @relation("replies")

  @@index([senderId])
  @@index([receiverId])
  @@index([parentMessageId])
  @@index([isRead])
  @@map("messages")
}

// ==================== OwnerApplication ====================
// オーナー応募（Phase 1 で使用）
// 運営専用アプリから同じDBを参照してステータス管理を行う
model OwnerApplication {
  id             String            @id @default(uuid())
  name           String // 応募者名
  email          String // 連絡先メールアドレス
  projectTitle   String // プロジェクトタイトル
  projectSummary String            @db.Text // プロジェクト概要
  projectStory   String            @db.Text // プロジェクト説明（ストーリー・想い）
  status         ApplicationStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("owner_applications")
}

enum ApplicationStatus {
  PENDING // 審査待ち
  REVIEWING // 審査中
  APPROVED // 承認
  REJECTED // 却下
}
